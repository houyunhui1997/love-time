{
  "bsonType": "object",
  "description": "恋爱档案",
  "required": ["ownerUid", "partnerName", "loveStartDate", "theme", "createdAt", "updatedAt", "revision"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false,
    "count": false
  },
  "properties": {
    "_id": { "description": "系统主键" },
    "ownerUid": { "bsonType": "string", "description": "档案创建者" },
    "partnerName": { "bsonType": "string", "maxLength": 12, "description": "对方称呼（选填）" },
    "loveStartDate": { "bsonType": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "theme": { "bsonType": "string", "enum": ["warm-paper", "clean"] },
    "createdAt": { "bsonType": "long" },
    "updatedAt": { "bsonType": "long" },
    "revision": { "bsonType": "int", "minimum": 1 }
  }
}
