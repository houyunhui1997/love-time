{
  "bsonType": "object",
  "description": "空间邀请链接",
  "required": ["spaceId", "inviterUid", "token", "status", "expiresAt", "createdAt", "updatedAt"],
  "permission": { "read": false, "create": false, "update": false, "delete": false, "count": false },
  "properties": {
    "_id": { "description": "系统主键" },
    "spaceId": { "bsonType": "string" },
    "inviterUid": { "bsonType": "string" },
    "token": { "bsonType": "string", "minLength": 32, "maxLength": 64 },
    "status": { "bsonType": "string", "enum": ["active", "used", "expired", "revoked"] },
    "expiresAt": { "bsonType": "long" },
    "usedByUid": { "bsonType": ["string", "null"] },
    "usedAt": { "bsonType": ["long", "null"] },
    "createdAt": { "bsonType": "long" },
    "updatedAt": { "bsonType": "long" }
  }
}
