{
  "bsonType": "object",
  "description": "用户约会计划，仅经鉴权的 plan-co 访问",
  "required": ["records", "revision", "updatedAt"],
  "permission": { "read": false, "create": false, "update": false, "delete": false, "count": false },
  "properties": {
    "_id": { "bsonType": "string", "description": "uni-id 用户 ID" },
    "records": {
      "bsonType": "array",
      "maxItems": 200,
      "items": {
        "bsonType": "object",
        "required": ["id", "title", "date", "time", "location", "note", "cover", "arrangements", "preparations", "createdAt", "updatedAt"],
        "properties": {
          "id": { "bsonType": "string" },
          "title": { "bsonType": "string", "maxLength": 30 },
          "date": { "bsonType": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "time": { "bsonType": "string", "maxLength": 5 },
          "location": { "bsonType": "string", "maxLength": 50 },
          "note": { "bsonType": "string", "maxLength": 200 },
          "cover": { "bsonType": "string", "maxLength": 160 },
          "arrangements": { "bsonType": "array", "maxItems": 30 },
          "preparations": { "bsonType": "array", "maxItems": 30 },
          "createdAt": { "bsonType": "long" },
          "updatedAt": { "bsonType": "long" }
        }
      }
    },
    "revision": { "bsonType": "int" },
    "updatedAt": { "bsonType": "long" }
  }
}
