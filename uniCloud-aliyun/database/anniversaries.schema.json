{
  "bsonType": "object",
  "description": "纪念日",
  "required": [
    "creatorUid",
    "title",
    "eventType",
    "targetDate",
    "calendarType",
    "repeatType",
    "reminderOffsetDays",
    "reminderTime",
    "note",
    "pinned",
    "source",
    "status",
    "createdAt",
    "updatedAt",
    "revision"
  ],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false,
    "count": false
  },
  "properties": {
    "reminderVersion": { "bsonType": "int", "description": "2: 空数组关闭，0当天；缺省记录的0按旧版关闭处理" },
    "subscription": { "bsonType": "object", "description": "仅服务端维护的一次性订阅任务，含接收人和任务状态" },
    "_id": { "description": "系统主键" },
    "creatorUid": { "bsonType": "string" },
    "title": { "bsonType": "string", "minLength": 1, "maxLength": 20 },
    "eventType": { "bsonType": "string", "enum": ["countdown", "anniversary", "birthday"] },
    "targetDate": { "bsonType": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "calendarType": { "bsonType": "string", "enum": ["solar"] },
    "repeatType": { "bsonType": "string", "enum": ["none", "yearly"] },
    "reminderOffsetDays": {
      "bsonType": "array",
      "uniqueItems": true,
      "items": { "bsonType": "int", "enum": [0, 1, 3, 7] }
    },
    "reminderTime": { "bsonType": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
    "note": { "bsonType": "string", "maxLength": 100 },
    "pinned": { "bsonType": "bool" },
    "source": { "bsonType": "string", "enum": ["user", "love-profile"] },
    "status": { "bsonType": "string", "enum": ["active", "deleted"] },
    "createdAt": { "bsonType": "long" },
    "updatedAt": { "bsonType": "long" },
    "deletedAt": { "bsonType": ["long", "null"] },
    "revision": { "bsonType": "int", "minimum": 1 }
  }
}


